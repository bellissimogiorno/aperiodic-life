      "name": "Conway",
      "rule": "B3/S23",
      "states": 2,
      "status": "Standard published rule",
      "creditAndScope": "John H. Conway; original public account by Martin Gardner (1970). Standard Conway Life uses the eight-neighbour square graph. On another selected graph this preset transfers the same counts, producing a different automaton.",
      "sources": [
        {
          "label": "Golly, QuickLife algorithm documentation",
          "url": "https://golly.sourceforge.io/Help/Algorithms/QuickLife.html",
          "reference": 14
        },
